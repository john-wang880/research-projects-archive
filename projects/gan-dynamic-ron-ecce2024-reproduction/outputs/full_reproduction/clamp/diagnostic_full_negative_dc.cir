* Fig.5 physical clamp, public topology and representative official MOSFETs
* Wide-range verification at +/-5 V on-state, representative parts, not author BOM
.include models/stn1nk60z.lib
.include models/DMG2302UK_official.lib
.param VBUS=150 VON=-5 RDRV=20 CPROBE=14p
* event at 1 us: DUT drain voltage falls in 20 ns, 10 A -> 48 mOhm illustration
Vdut input 0 -5
Vdrive_block drv_block out 10
Rgate_block drv_block gate_block {RDRV}
Xblocking input gate_block out STN1NK60Z
Vdrive_btb drv_btb middle 0
Rgate_top drv_btb gate_top 300
Rgate_bot drv_btb gate_bot 300
Xbtb_top out gate_top middle DMG2302UK
Xbtb_bot 0 gate_bot middle DMG2302UK
* Bidirectional TVS reduced model: nominal ~8 V, capacitance 3 pF
* TI ESDS452 representative V_RWM=5.5 V, V_BRtyp=8 V, R_dyn=0.29 Ohm
Dtvsp out tvs_mid DTVS
Dtvsm 0 tvs_mid DTVS
.model DTVS D(Is=1p N=1.25 Rs=0.145 BV=7.3 IBV=1m Cjo=6p)
Rprobe out 0 1Meg
Cprobe out 0 {CPROBE}
* Explicit additional PCB/probe strays: illustration, not known author layout
Cstray out 0 5p
Rmid_leak middle 0 100Meg
.tran 0 0.1u 0 0.1n
.options plotwinsize=0 reltol=1e-5 abstol=1e-10
.save V(input) V(out) V(gate_block,out) V(gate_top,middle) I(Vdut) I(Dtvsp) I(Dtvsm)
.meas TRAN output_peak MAX V(out) FROM 0.95u TO 1.7u
.meas TRAN output_min MIN V(out) FROM 0.95u TO 1.7u
.meas TRAN off_peak MAX V(out) FROM 1.9u TO 2.3u
.meas TRAN plateau AVG V(out) FROM 1.4u TO 1.8u
.end
